+    s = rt->atom_array[a];
+    if (s->len != n || s->is_wide_char)
+        return false;
+    c = str8(s);
+    for (i = 0; i < n; i++) {
+        if (c[i] != k[i])
+            return false;
+    }
+    return true;
+}
