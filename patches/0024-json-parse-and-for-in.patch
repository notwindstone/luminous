+static no_inline double jf_strtod(JSContext *ctx, const uint8_t *s, size_t n, bool *ok)
+{
+    char small[64], *t = n < sizeof(small) ? small : js_malloc(ctx, n + 1);
+    double d;
+    if (!t) {
+        *ok = false;
+        return 0;
+    }
