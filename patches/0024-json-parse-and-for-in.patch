+static inline uint32_t jf_slot(const uint8_t *k, uint32_t n)
+{
+    uint32_t h = n * 0x9e3779b1u;
+    if (n)
+        h += (k[0] | (uint32_t)k[n - 1] << 8 | (uint32_t)k[n >> 1] << 16) * 0x85ebca77u;
+    return h >> (32 - 6);
