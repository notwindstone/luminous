+/* Whether atom a is the key of these (plain) characters. */
+static inline bool jf_atom_is(JSRuntime *rt, JSAtom a, const uint8_t *k, uint32_t n)
+{
+    JSString *s;
+    const uint8_t *c;
+    uint32_t i;
+    if (__JS_AtomIsTaggedInt(a))
