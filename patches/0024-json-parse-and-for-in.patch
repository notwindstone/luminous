+        return -1;
+    if (*p == '0' && p + 1 < end && is_digit(p[1]))
+        return -1;
+    for (; p < end && is_digit(*p); p++) {
+        if (nd < 19)
+            m = m * 10 + (*p - '0'), nd += m != 0;
+        else
+            all = false;
+    }
+    if (p < end && *p == '.') {
+        integer = false;
+        if (++p >= end || !is_digit(*p))
+            return -1;
+        for (; p < end && is_digit(*p); p++) {
+            if (nd < 19)
+                m = m * 10 + (*p - '0'), nd += m != 0, e--;
+            else
+                all = false;
+        }
+    }
+    if (p < end && (*p == 'e' || *p == 'E')) {
+        bool eneg = false;
+        int x = 0;
+        integer = false;
+        p++;
+        if (p < end && (*p == '+' || *p == '-'))
+            eneg = *p++ == '-';
+        if (p >= end || !is_digit(*p))
+            return -1;
+        for (; p < end && is_digit(*p); p++) {
+            if (x < 100000)
