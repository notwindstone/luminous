+/* The atom of a key of these (plain) characters (a reference). */
+static JSAtom jf_atom(JSContext *ctx, const uint8_t *k, uint32_t n)
+{
+    JSValue str;
+    if (n == 0 || !is_digit(*k)) {
+        /* (else it may be an index: JS_NewAtomStr) */
+        JSAtom a = __JS_FindAtom(ctx->rt, (const char *)k, n, JS_ATOM_TYPE_STRING);
+        if (a != JS_ATOM_NULL)
+            return a;
+    }
+    str = js_new_string8_len(ctx, (const char *)k, n);
+    if (JS_IsException(str))
+        return JS_ATOM_NULL;
+    return JS_NewAtomStr(ctx, JS_VALUE_GET_STRING(str));
