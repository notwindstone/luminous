+/* ---- luminous: JSON.parse's fast path ----
+   The text's bytes parsed in place (a string's own Latin-1 characters, or
+   UTF-8), making the values directly: numbers exact without strtod where
+   they can be (int32s as such), strings scanned 8 bytes at a time, and
+   objects made with the shape of the last object whose keys began the same
+   way (ctx->json_shapes, by the first key) or of the array element before
+   (V8 follows the same transitions): each key is then compared with the
+   shape's, no atom looked up, and the values stored in the slots. Anything
+   else (an error, nesting deeper than JSON_FAST_DEPTH) returns
+   JS_UNINITIALIZED, and the general parser runs: the values and the errors
+   are always its own. */
+
+#define JSON_FAST_DEPTH 512
+
+typedef struct JSONFast {
+    JSContext *ctx;
+    const uint8_t *p, *end;
+    bool utf8; /* else Latin-1 characters */
+    bool strict; /* (UTF-8) no encoded surrogates: as a decoder reads it */
+} JSONFast;
+
+#define JF_ONES 0x0101010101010101ull
+#define JF_HIGHS 0x8080808080808080ull
+
+/* Of the 8 bytes at p (in a string), how many come before a quote, a
+   backslash, a control character or a non-ASCII byte. */
+static inline int jf_plain8(const uint8_t *p)
+{
+    uint64_t w, q, b, t;
+    memcpy(&w, p, 8);
+    q = w ^ ('"' * JF_ONES);
+    b = w ^ ('\\' * JF_ONES);
+    /* (bit 7 of each such byte; exact up to the first) */
+    t = (((q - JF_ONES) & ~q) | ((b - JF_ONES) & ~b) | ((w - 0x20 * JF_ONES) & ~w) | w) & JF_HIGHS;
+    if (!t)
+        return 8;
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+    return __builtin_ctzll(t) >> 3;
+#else
+    return 0;
+#endif
+}
+
+static inline void jf_ws(JSONFast *jf)
+{
+    while (jf->p < jf->end && *jf->p <= ' ' &&
+           (*jf->p == ' ' || *jf->p == '\n' || *jf->p == '\r' || *jf->p == '\t'))
+        jf->p++;
+}
+
+/* Character c, after any whitespace: passed. */
+static inline bool jf_char(JSONFast *jf, uint8_t c)
+{
+    if (jf->p < jf->end && *jf->p == c)
+        return jf->p++, true;
+    jf_ws(jf);
+    if (jf->p < jf->end && *jf->p == c)
+        return jf->p++, true;
+    return false;
+}
