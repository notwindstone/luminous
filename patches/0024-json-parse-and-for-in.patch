+/* The end of the plain characters from p (no quote, backslash or control
+   character, nor non-ASCII ones in UTF-8). */
+static inline const uint8_t *jf_scan(JSONFast *jf, const uint8_t *p)
+{
+    const uint8_t *end = jf->end;
+    for (;;) {
+        uint8_t c;
+        if (end - p >= 8) {
+            int n = jf_plain8(p);
+            p += n;
+            if (n == 8)
+                continue;
+        }
+        if (p >= end)
+            return p;
+        c = *p;
+        if (c == '"' || c == '\\' || c < 0x20 || (c >= 0x80 && jf->utf8))
+            return p;
+        p++;
+    }
+}
