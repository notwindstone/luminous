+/* Whether `obj`'s @@hasInstance is Function.prototype's (which is neither
+   writable nor configurable): no object on its prototype chain before
+   Function.prototype has one of its own. `instanceof` is then
+   OrdinaryHasInstance, without calling the method. */
+static bool js_default_has_instance(JSContext *ctx, JSValueConst obj)
+{
+    const JSObject *fp = JS_VALUE_GET_OBJ(ctx->function_proto);
+    JSObject *p = JS_VALUE_GET_OBJ(obj);
+    for (int depth = 0; p && depth < 16; depth++) {
+        if (p == fp)
+            return true;
+        if (p->class_id == JS_CLASS_PROXY || p->is_exotic ||
+            find_own_property1(p, JS_ATOM_Symbol_hasInstance))
+            return false;
+        p = p->shape->proto;
+    }
+    return false;
+}
