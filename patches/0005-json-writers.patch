+   an integer below 2^53 or a decimal of at most 8 fraction digits (else
+   -1). The decimal is the shortest that reads back as d: m / 10^k for the
+   least k at which the nearest integer m to |d| * 10^k gives exactly |d|
+   when divided by 10^k (that division and reading the decimal back both
+   round m / 10^k correctly, and m stays below 2^50, where |d| * 10^k is
+   computed closely enough for m to be the nearest). */
+static int js_dtoa_short(char *buf, double d)
+{
+    static const double pow10[] = { 1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8 };
+    double a = fabs(d), m;
+    char digits[24], *q = buf;
+    int k, len;
+    if (a < 0x1p53 && a == trunc(a)) {
+        if (d < 0)
+            *q++ = '-';
+        return q - buf + js_json_u64((uint8_t *)q, (uint64_t)a);
+    }
+    if (!(a >= 1e-6 && a < 0x1p50))
+        return -1;
+    for (k = 1; k <= 8; k++) {
+        m = a * pow10[k];
+        if (m >= 0x1p50)
+            return -1;
+        m = floor(m + 0.5);
+        if (m / pow10[k] == a)
+            break;
+    }
+    if (k > 8)
+        return -1;
+    len = js_json_u64((uint8_t *)digits, (uint64_t)m);
+    if (d < 0)
+        *q++ = '-';
+    if (len > k) {
+        memcpy(q, digits, len - k);
+        q += len - k;
+        *q++ = '.';
+    } else {
+        *q++ = '0';
+        *q++ = '.';
+        memset(q, '0', k - len);
+        q += k - len;
+    }
+    memcpy(q, digits + len - min_int(len, k), min_int(len, k));
+    return q + min_int(len, k) - buf;
+}
