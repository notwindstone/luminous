+static int js_json_fast_run(JSContext *ctx, JSValueConst obj, JSValue *pres)
+{
+    JSRuntime *rt = ctx->rt;
+    StringBuffer b;
+    JSString *str;
+    int r;
+    b.ctx = ctx;
+    b.len = 0;
+    b.is_wide_char = 0;
+    b.error_status = 0;
+    b.str = rt->json_buf;
+    b.size = rt->json_buf_size;
+    rt->json_buf = NULL; /* (in use) */
+    if (!b.str) {
+        b.size = 256;
