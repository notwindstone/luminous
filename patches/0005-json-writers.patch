+int JS_SetJSONWriter(JSClassID class_id, JSJSONWriteFunc *fn)
+{
+    for (int k = 0; k < js_json_writer_count; k++) {
+        if (js_json_writer_class[k] == class_id) {
+            js_json_writer_fn[k] = fn;
+            return 0;
+        }
+    }
+    if (js_json_writer_count == JS_JSON_WRITERS)
+        return -1;
+    js_json_writer_class[js_json_writer_count] = class_id;
+    js_json_writer_fn[js_json_writer_count] = fn;
+    js_json_writer_count++;
+    return 0;
+}
