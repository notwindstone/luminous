+/* luminous: what a class's construction does with an instance, for native
+   constructors: define a private field (`val` taken), and give it the
+   brand of the class whose prototype is `home` (for its private methods
+   and accessors). */
+int JS_PrivateDefine(JSContext *ctx, JSValueConst obj, JSValueConst name, JSValue val)
+{
+    return JS_DefinePrivateField(ctx, obj, unsafe_unconst(name), val);
+}
