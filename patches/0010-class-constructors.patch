+/* luminous: make function `func` (of JS_NewCFunctionData*) a class
+   constructor: `new` calls `call` with this_val new.target (its result is
+   the instance), a call without `new` throws. It has no fast entry then
+   (which calls would take). */
+int JS_SetCFunctionDataClassConstructor(JSContext *ctx, JSValueConst func, JSCFunctionData *call)
+{
+    JSCFunctionDataRecord *s = JS_GetOpaque(func, JS_CLASS_C_FUNCTION_DATA);
+    if (!s)
+        return 0;
+    s->class_ctor = 1;
+    s->fast = NULL;
+    s->func = call;
+    JS_SetConstructorBit(ctx, func, true);
+    return 0;
+}
