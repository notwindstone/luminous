+/* The number of own enumerable string-keyed properties of an ordinary
+   object or a fast array (`Object.keys(obj).length`), without making the
+   keys; -1 for any other value (an exotic object: the caller asks it). */
+int64_t JS_CountOwnKeys(JSContext *ctx, JSValueConst obj)
+{
+    JSObject *p;
+    JSShape *sh;
+    JSShapeProperty *prs;
+    int64_t n = 0;
+    int i, k;
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return -1;
+    p = JS_VALUE_GET_OBJ(obj);
+    if (p->is_exotic) {
+        if (p->class_id != JS_CLASS_ARRAY || !p->fast_array)
+            return -1;
+        n = p->u.array.count;
+    }
+    sh = p->shape;
+    if (sh->is_hashed && sh->keys_count >= 0)
+        return n + sh->keys_count;
+    k = 0;
+    for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+        if (prs->atom != JS_ATOM_NULL && (prs->flags & JS_PROP_ENUMERABLE) &&
+            JS_AtomGetKind(ctx, prs->atom) == JS_ATOM_KIND_STRING)
+            k++;
+    }
+    if (sh->is_hashed)
+        sh->keys_count = k;
+    return n + k;
+}
