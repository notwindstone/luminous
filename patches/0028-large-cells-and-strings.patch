+/* luminous: a new string of `len` characters (8-bit, or 16-bit if
+   `is_wide`) that the caller writes at *pbuf, all of them, before
+   anything else runs; or JS_EXCEPTION. (What a file holds read straight
+   into its string.) */
+JSValue JS_NewStringUninit(JSContext *ctx, size_t len, int is_wide, void **pbuf)
+{
+    JSString *str;
+    if (len == 0) {
+        *pbuf = NULL;
+        return JS_AtomToString(ctx, JS_ATOM_empty_string);
+    }
+    if (len > JS_STRING_LEN_MAX)
+        return JS_ThrowRangeError(ctx, "invalid string length");
+    str = js_alloc_string(ctx, len, is_wide);
+    if (!str)
+        return JS_EXCEPTION;
+    if (is_wide) {
+        *pbuf = str16(str);
+    } else {
+        str8(str)[len] = '\0';
+        *pbuf = str8(str);
+    }
+    return JS_MKPTR(JS_TAG_STRING, str);
+}
+
+/* luminous: shortens a string JS_NewStringUninit made, while no other code
+   has seen it, to `len` characters (no more than it has). */
+void JS_ShrinkNewString(JSContext *ctx, JSValueConst val, size_t len)
+{
+    JSString *str;
+    (void)ctx;
+    if (JS_VALUE_GET_TAG(val) != JS_TAG_STRING)
+        return;
+    str = JS_VALUE_GET_STRING(val);
+    if (len >= str->len)
+        return;
+    str->len = len;
+    if (!str->is_wide_char)
+        str8(str)[len] = '\0';
+}
