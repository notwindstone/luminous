+/* (Before a collection traces) the frame region's live objects: their
+   alloc bits set, every other bit clear (none old, none aged: they are
+   traced as roots by every collection, see js_gc_mark_roots). */
+static void js_gc_frame_prepare(JSRuntime *rt)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    JSGCChunk *ch = h->frame_chunk;
+    uint8_t *s, *start;
+    if (!ch)
+        return;
+    memset(ch->bits, 0, 2 * ch->n_words * sizeof(uint64_t));
+    memset(JS_GC_AGE(ch), 0, ch->n_words * sizeof(uint64_t));
+    start = (uint8_t *)ch + ch->first;
+    for (s = h->frame_top > start ? start : NULL; s; s = js_gc_frame_next(s, h->frame_top)) {
+        JSObject *p = js_gc_frame_object(s);
+        if (p) {
+            uint32_t i = js_gc_index(ch, (uintptr_t)js_rc(p));
+            ch->bits[i >> 6] |= (uint64_t)1 << (i & 63);
+        }
+    }
+}
+
+static void js_gc_frame_roots(JSRuntime *rt, JS_MarkFunc *mark_func)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    JSGCChunk *ch = h->frame_chunk;
+    uint8_t *s, *start;
+    if (!ch)
+        return;
+    start = (uint8_t *)ch + ch->first;
+    for (s = h->frame_top > start ? start : NULL; s; s = js_gc_frame_next(s, h->frame_top)) {
+        JSObject *p = js_gc_frame_object(s);
