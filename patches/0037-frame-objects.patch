+static void js_gc_frame_init(JSRuntime *rt)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    JSGCChunk *ch = js_gc_map(JS_GC_CHUNK_SIZE);
+    uint32_t n, words;
+    size_t hdr;
+    if (!ch)
