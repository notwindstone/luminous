+/* Whether `b` (in the frame region's chunk) is a live object's header as
+   the collection running found them (js_gc_frame_prepare): a reference to
+   anything else there is stale (from what is dead itself). */
+static inline bool js_gc_frame_live(JSGCChunk *ch, const JSMallocBlockHeader *b)
+{
+    uint32_t i;
+    if ((uintptr_t)b < (uintptr_t)ch + ch->first)
+        return false;
+    i = js_gc_index(ch, (uintptr_t)b);
+    return i < ch->n_cells && (ch->bits[i >> 6] & ((uint64_t)1 << (i & 63)));
+}
+
+void JS_GCFramePin(JSRuntime *rt)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    if (h->frame_top > h->frame_floor)
+        h->frame_floor = h->frame_top;
+}
+
+void JS_GCFrameExpose(JSRuntime *rt, JSValueConst v)
+{
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_OBJECT &&
+        ((uintptr_t)JS_VALUE_GET_PTR(v) & JS_GC_CHUNK_MASK) == (uintptr_t)rt->gc_heap.frame_chunk)
+        JS_GCFramePin(rt);
+}
