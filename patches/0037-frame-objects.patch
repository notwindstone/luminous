+    ch->cell_size = 8;
+    ch->n_cells = n;
+    ch->first = hdr;
+    ch->n_words = words;
+    ch->cls = JS_GC_FRAME;
+    ch->inv = (((uint64_t)1 << 40) + 7) / 8;
+    init_list_head(&ch->link);
+    init_list_head(&ch->avail_link);
