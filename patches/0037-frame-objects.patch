+    for (;;) {
+        words = (n + 63) / 64;
+        hdr = (sizeof(JSGCChunk) + JS_GC_BITMAPS * 8 * words + 15) & ~(size_t)15;
+        if (hdr + (size_t)n * 8 <= JS_GC_CHUNK_SIZE)
