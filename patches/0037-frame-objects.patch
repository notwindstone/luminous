+void JS_MarkEmbeddedObjects(JSRuntime *rt, void *owner, void *start, void *end, JS_MarkFunc *mark_func)
+{
+    JSMallocBlockHeader *ob = js_rc(owner);
+    uint8_t *s;
+    for (s = start < end ? start : NULL; s; s = js_gc_frame_next(s, end)) {
+        JSObject *p = js_gc_frame_object(s);
+        if (p) {
+            JSMallocBlockHeader *b = js_rc(p);
+            b->mark = ob->mark;
+            b->gc_remembered = ob->gc_remembered;
+            mark_children(rt, &p->header, mark_func);
+        }
+    }
+}
