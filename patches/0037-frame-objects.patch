+    s += size;
+    return size && s < end ? s : NULL;
+}
+
+static inline JSObject *js_gc_frame_object(uint8_t *s)
+{
+    return ((uint32_t *)s)[1] ? (JSObject *)(s + 8 + sizeof(JSMallocBlockHeader)) : NULL;
