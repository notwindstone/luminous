+
+/* (After the trace) the frame objects are not old (the write barrier
+   leaves them: they are roots) nor remembered. */
+static void js_gc_frame_reset(JSRuntime *rt)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    JSGCChunk *ch = h->frame_chunk;
+    uint8_t *s, *start;
+    if (!ch)
+        return;
+    start = (uint8_t *)ch + ch->first;
+    for (s = h->frame_top > start ? start : NULL; s; s = js_gc_frame_next(s, h->frame_top)) {
+        JSObject *p = js_gc_frame_object(s);
+        if (p) {
+            js_rc(p)->mark = 0;
+            js_rc(p)->gc_remembered = 0;
