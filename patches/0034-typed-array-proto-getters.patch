+int JS_CacheProtoGetter(JSContext *ctx, JSValueConst obj, JSAtom prop, void **shapes, int *pdepth)
+{
+    JSObject *chain[4];
+    JSShapeProperty *prs = NULL;
+    JSProperty *pr;
+    int i, k;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT || __JS_AtomIsTaggedInt(prop))
+        return -1;
+    chain[0] = JS_VALUE_GET_OBJ(obj);
+    if (!js_cacheable_holder(ctx, chain[0], prop) || find_own_property(&pr, chain[0], prop))
+        return -1;
+    for (i = 1; i < 4; i++) {
+        chain[i] = chain[i - 1]->shape->proto;
+        if (!chain[i] || !js_cacheable_holder(ctx, chain[i], prop))
+            return -1;
+        prs = find_own_property(&pr, chain[i], prop);
+        if (prs)
+            break;
+    }
+    if (!prs || (prs->flags & JS_PROP_TMASK) != JS_PROP_GETSET || !js_ref_obj(pr->u.getset.getter))
+        return -1;
+    for (k = 0; k <= i; k++)
+        shapes[k] = js_dup_shape(chain[k]->shape);
+    *pdepth = i;
+    return pr - chain[i]->prop;
+}
