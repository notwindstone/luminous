+    case JS_BINOP_SUB: ret = js_binary_arith_slow(ctx, sp, OP_sub); break;
+    case JS_BINOP_MUL: ret = js_binary_arith_slow(ctx, sp, OP_mul); break;
+    case JS_BINOP_DIV: ret = js_binary_arith_slow(ctx, sp, OP_div); break;
+    case JS_BINOP_MOD: ret = js_binary_arith_slow(ctx, sp, OP_mod); break;
+    case JS_BINOP_POW: ret = js_binary_arith_slow(ctx, sp, OP_pow); break;
+    case JS_BINOP_SHL: ret = js_binary_logic_slow(ctx, sp, OP_shl); break;
+    case JS_BINOP_SAR: ret = js_binary_logic_slow(ctx, sp, OP_sar); break;
+    case JS_BINOP_SHR: ret = js_shr_slow(ctx, sp); break;
+    case JS_BINOP_AND: ret = js_binary_logic_slow(ctx, sp, OP_and); break;
+    case JS_BINOP_OR:  ret = js_binary_logic_slow(ctx, sp, OP_or); break;
+    case JS_BINOP_XOR: ret = js_binary_logic_slow(ctx, sp, OP_xor); break;
+    case JS_BINOP_LT:  ret = js_relational_slow(ctx, sp, OP_lt); break;
+    case JS_BINOP_LTE: ret = js_relational_slow(ctx, sp, OP_lte); break;
+    case JS_BINOP_GT:  ret = js_relational_slow(ctx, sp, OP_gt); break;
+    case JS_BINOP_GTE: ret = js_relational_slow(ctx, sp, OP_gte); break;
+    case JS_BINOP_EQ:  ret = js_eq_slow(ctx, sp, false); break;
+    case JS_BINOP_NEQ: ret = js_eq_slow(ctx, sp, true); break;
+    case JS_BINOP_STRICT_EQ:  ret = js_strict_eq_slow(ctx, sp, false); break;
+    case JS_BINOP_STRICT_NEQ: ret = js_strict_eq_slow(ctx, sp, true); break;
