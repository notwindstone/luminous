+        uint64_t w = bits[i >> 6];
+        if (!set)
+            w = ~w;
+        w &= ~(uint64_t)0 << (i & 63);
+        if (w) {
+            i = (i & ~63u) + ctz64(w);
+            return i < n ? i : n;
