+        return -1;
+    p = JS_VALUE_GET_OBJ(obj);
+    /* Only shared shapes: an unhashed shape belongs to one object, which
+       may modify it in place. A hashed one, once referenced here, is cloned
+       by any modification (js_shape_prepare_update, add_property). */
+    if (!p->shape->is_hashed)
+        return -1;
