+/* Stable merge sort of a[0..n) (tmp: room for n / 2 + 1 values). */
+static void js_native_merge_sort(JSNativeSort *s, JSValue *a, JSValue *tmp, size_t n)
+{
+    size_t i, j, k, m;
+    if (n <= 8) {
+        for (i = 1; i < n && !s->failed; i++) {
+            JSValue x = a[i];
+            for (j = i; j > 0; j--) {
+                if (js_native_compare(s, a[j - 1], x) <= 0 || s->failed)
+                    break;
+                a[j] = a[j - 1];
+            }
+            a[j] = x;
+        }
+        return;
+    }
+    m = n / 2;
+    js_native_merge_sort(s, a, tmp, m);
+    if (!s->failed)
+        js_native_merge_sort(s, a + m, tmp, n - m);
+    if (s->failed || js_native_compare(s, a[m - 1], a[m]) <= 0 || s->failed)
+        return;
+    memcpy(tmp, a, m * sizeof(JSValue));
+    i = 0; j = m; k = 0;
+    while (i < m && j < n) {
+        double c = js_native_compare(s, tmp[i], a[j]);
+        if (s->failed) {
+            /* (Every value back in the array, in some order.) */
+            memcpy(a + k, tmp + i, (m - i) * sizeof(JSValue));
+            return;
+        }
+        if (c <= 0)
+            a[k++] = tmp[i++];
+        else
+            a[k++] = a[j++];
+    }
+    while (i < m)
+        a[k++] = tmp[i++];
+}
