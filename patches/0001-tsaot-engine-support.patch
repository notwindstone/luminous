+bool JS_GetClosureVariable(JSContext *ctx, JSValueConst func, JSAtom name, JSValue *pval)
+{
+    JSObject *p;
+    JSFunctionBytecode *b;
+    int i;
+
+    if (JS_VALUE_GET_TAG(func) != JS_TAG_OBJECT)
+        return false;
+    p = JS_VALUE_GET_OBJ(func);
+    if (!js_class_has_bytecode(p->class_id))
+        return false;
+    b = p->u.func.function_bytecode;
+    for (i = 0; i < b->closure_var_count; i++) {
+        if (b->closure_var[i].var_name == name && p->u.func.var_refs && p->u.func.var_refs[i]) {
+            *pval = js_dup(*p->u.func.var_refs[i]->pvalue);
+            return true;
+        }
+    }
+    return false;
+}
