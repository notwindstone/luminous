+/* Calls the JSCFunctionFast entry of C function data `func_obj`. Returns
+   JS_UNINITIALIZED if there is none or it declined, in which case the caller
+   takes the regular call path. Lets the interpreter's call opcodes enter
+   native code without a JS_CallInternal frame. The result is returned by
+   value, in registers: taking the address of the interpreter's ret_val
+   would force every call result through memory. */
+static no_inline JSValue js_call_fast(JSContext *ctx, JSValueConst func_obj,
+                                     JSValueConst this_val,
+                                     int argc, JSValueConst *argv)
+{
+    JSCFunctionDataRecord *s = JS_VALUE_GET_OBJ(func_obj)->u.c_function_data_record;
+
+    if (!s->fast)
+        return JS_UNINITIALIZED;
+    return s->fast(ctx, this_val, argc, argv, vc(s->data));
+}
