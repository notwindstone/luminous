+static void *js_gc_map_chunk(JSGCHeap *h)
+{
+#if defined(__linux__)
+    void *c;
+    if (h->region == h->region_end) {
+        size_t len = 2 * JS_GC_REGION_SIZE;
+        uint8_t *p = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        uint8_t *a, *end;
+        if (p == MAP_FAILED)
+            return NULL;
+        a = (uint8_t *)(((uintptr_t)p + JS_GC_REGION_SIZE - 1) & ~(uintptr_t)(JS_GC_REGION_SIZE - 1));
+        end = p + len;
+        if (a > p)
+            munmap(p, a - p);
+        if (end > a + JS_GC_REGION_SIZE)
+            munmap(a + JS_GC_REGION_SIZE, end - (a + JS_GC_REGION_SIZE));
+        h->region = a;
+        h->region_end = a + JS_GC_REGION_SIZE;
+    }
+    c = h->region;
+    h->region += JS_GC_CHUNK_SIZE;
+    return c;
+#else
+    return js_gc_map(JS_GC_CHUNK_SIZE);
+#endif
+}
+
+static void js_gc_unmap(void *p, size_t size)
+{
+#if defined(__unix__) || defined(__APPLE__)
+    munmap(p, size);
+#else
+    free(p);
+#endif
