+/* tsaot: the entry of rt->weak_heads listing the weak references to `p`,
+   made if it has none (-1 when out of memory). */
+static int js_weak_index_new(JSContext *ctx, JSObject *p)
+{
+    JSRuntime *rt = ctx->rt;
+    uint32_t i;
+    if (p->weak_index)
+        return 0;
+    if (rt->weak_free_len > 0) {
+        i = rt->weak_free[--rt->weak_free_len];
+    } else {
+        if (rt->weak_heads_len == 0)
+            rt->weak_heads_len = 1; /* (0: none) */
+        if (rt->weak_heads_len >= rt->weak_heads_size) {
+            uint32_t n = rt->weak_heads_size ? 2 * rt->weak_heads_size : 64;
+            JSWeakRefRecord **a = js_realloc(ctx, rt->weak_heads, n * sizeof(*a));
+            if (!a)
+                return -1;
+            rt->weak_heads = a;
+            rt->weak_heads_size = n;
+        }
+        i = rt->weak_heads_len++;
+    }
+    rt->weak_heads[i] = NULL;
+    p->weak_index = i;
+    return 0;
+}
+
+/* `p`'s entry of rt->weak_heads (its list released) free again. */
+static void js_weak_index_free(JSRuntime *rt, JSObject *p)
+{
+    uint32_t i = p->weak_index;
+    p->weak_index = 0;
+    if (rt->weak_free_len == rt->weak_free_size) {
+        uint32_t n = rt->weak_free_size ? 2 * rt->weak_free_size : 64;
+        uint32_t *a = js_realloc_rt(rt, rt->weak_free, n * sizeof(*a));
+        if (!a)
+            return; /* (the entry is lost: harmless) */
+        rt->weak_free = a;
+        rt->weak_free_size = n;
+    }
+    rt->weak_free[rt->weak_free_len++] = i;
