+    struct list_head *el;
+    list_for_each(el, &ts->os_rw_handlers) {
+        JSOSRWHandler *rh = list_entry(el, JSOSRWHandler, link);
+        JS_MarkValue(rt, rh->rw_func[0], mark_func);
+        JS_MarkValue(rt, rh->rw_func[1], mark_func);
+    }
+    list_for_each(el, &ts->os_signal_handlers) {
+        JSOSSignalHandler *sh = list_entry(el, JSOSSignalHandler, link);
+        JS_MarkValue(rt, sh->func, mark_func);
+    }
+    list_for_each(el, &ts->os_timers) {
+        JSOSTimer *th = list_entry(el, JSOSTimer, link);
+        JS_MarkValue(rt, th->func, mark_func);
+    }
+    list_for_each(el, &ts->rejected_promise_list) {
+        JSRejectedPromiseEntry *rp = list_entry(el, JSRejectedPromiseEntry, link);
+        JS_MarkValue(rt, rp->promise, mark_func);
+        JS_MarkValue(rt, rp->reason, mark_func);
+    }
+#ifdef USE_WORKER
+    list_for_each(el, &ts->port_list) {
+        JSWorkerMessageHandler *port = list_entry(el, JSWorkerMessageHandler, link);
+        JS_MarkValue(rt, port->on_message_func, mark_func);
+    }
+#endif
+}
