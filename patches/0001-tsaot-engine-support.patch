+static void js_gc_free_chunk(JSRuntime *rt, JSGCChunk *ch)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    size_t off;
+    list_del(&ch->link);
+    if (ch->cls != JS_GC_LARGE && ch->n_allocated < ch->n_cells)
+        list_del(&ch->avail_link);
+    for (off = 0; off < ch->size; off += JS_GC_CHUNK_SIZE)
+        js_gc_table_del(h, (uintptr_t)ch + off);
+    h->n_chunks--;
