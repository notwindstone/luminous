+        sh = js_dup_shape(sh);
+    } else {
+        sh = js_new_shape(ctx, proto);
+        if (!sh)
+            return JS_EXCEPTION;
+    }
+    js_trigger_gc(ctx->rt, sizeof(JSObject) + size);
+    p = js_malloc(ctx, sizeof(JSObject) + size);
+    if (!p) {
+        js_free_shape(ctx->rt, sh);
+        return JS_EXCEPTION;
+    }
+    /* The data is the caller's to initialize. */
+    memset(p, 0, sizeof(JSObject));
+    p->class_id = class_id;
+    p->extensible = extensible;
+    p->is_exotic = ctx->rt->class_array[class_id].exotic != NULL;
+    p->shape = sh;
+    p->prop = NULL;
+    p->u.opaque = p + 1;
+    *pdata = p + 1;
+    JS_REF_COUNT(p) = 1;
+    add_gc_object(ctx->rt, &p->header, JS_GC_OBJ_TYPE_JS_OBJECT);
+    return JS_MKPTR(JS_TAG_OBJECT, p);
+}
+
+JSValue JS_NewObjectWithCachedShape(JSContext *ctx, void *shape, JSValue *values)
+{
+    static_assert(sizeof(JSProperty) == sizeof(JSValue), "");
+    JSRuntime *rt = ctx->rt;
+    JSShape *sh = shape;
+    size_t total = sizeof(JSMallocBlockHeader) + sizeof(JSObject) +
+        sizeof(JSProperty) * sh->prop_size;
+    /* Fast: a block from the arena cache, when no collection is due (as
+       JS_NewObjectFromShape would make it, with the values taken). */
+    if (likely(total <= JS_ARENA_MAX_SMALL_SIZE)) {
+        JSMallocState *s = &rt->malloc_state;
+        unsigned int idx = rt->arena_state.size_index[total / 8];
+        JSArenaCache *c = &rt->arena_state.cache[idx];
+        size_t used = arena_block_sizes[idx] - sizeof(JSMallocBlockHeader) + MALLOC_OVERHEAD;
+        JSObject *p = c->head;
+        if (likely(p != NULL &&
+                   s->malloc_size + used <= rt->malloc_gc_threshold &&
+                   s->malloc_size + used <= s->malloc_limit - 1)) {
+            JSMallocBlockHeader *b = js_rc(p);
+            int i, n = sh->prop_count;
+            c->head = *(void **)p;
+            c->count--;
+            s->malloc_count++;
+            s->malloc_size += used;
+            b->gc_obj_type = JS_GC_OBJ_TYPE_JS_OBJECT;
+            b->mark = 0;
+            b->ref_count = 1;
+            p->is_prototype = 0;
+            p->extensible = true;
+            p->free_mark = 0;
+            p->is_exotic = 0;
+            p->fast_array = 0;
+            p->is_constructor = 0;
+            p->is_uncatchable_error = 0;
+            p->tmp_mark = 0;
+            p->is_HTMLDDA = 0;
+            p->class_id = JS_CLASS_OBJECT;
+            p->shape = js_dup_shape(sh);
+            p->prop = (JSProperty *)(p + 1);
+            p->first_weak_ref = NULL;
+            p->u.opaque = NULL;
+            list_add_tail(&p->header.link, &rt->gc_obj_list);
+            for (i = 0; i < n; i++)
+                p->prop[i].u.value = values[i];
+            return JS_MKPTR(JS_TAG_OBJECT, p);
+        }
+    }
+    return JS_NewObjectFromShape(ctx, js_dup_shape(sh), JS_CLASS_OBJECT, (JSProperty *)values);
+}
