+/* `size` bytes (a multiple of the page size, or of JS_GC_CHUNK_SIZE),
+   zeroed, aligned to JS_GC_CHUNK_SIZE. */
+static void *js_gc_map(size_t size)
+{
+#if defined(__unix__) || defined(__APPLE__)
+    size_t len = size + JS_GC_CHUNK_SIZE;
+    uint8_t *p = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    uint8_t *a, *end;
+    if (p == MAP_FAILED)
+        return NULL;
+    a = (uint8_t *)(((uintptr_t)p + JS_GC_CHUNK_SIZE - 1) & JS_GC_CHUNK_MASK);
+    end = p + len;
+    if (a > p)
+        munmap(p, a - p);
+    if (end > a + size)
+        munmap(a + size, end - (a + size));
+    return a;
+#else
+    void *p = aligned_alloc(JS_GC_CHUNK_SIZE, size);
+    if (p)
+        memset(p, 0, size);
+    return p;
+#endif
