+/* A global variable reference, as in strict mode code: ReferenceError if it
+   does not exist. */
+JSValue JS_GetGlobalVariable(JSContext *ctx, JSAtom prop)
+{
+    return JS_GetGlobalVar(ctx, prop, true);
+}
+
+/* Assignment to a global variable with strict mode semantics, whatever the
+   current stack frame: ReferenceError if it does not exist, TypeError if it
+   is read-only. Frees `val`. */
+int JS_SetGlobalVariable(JSContext *ctx, JSAtom prop, JSValue val)
+{
+    JSObject *p;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    int ret;
+
+    p = JS_VALUE_GET_OBJ(ctx->global_var_obj);
+    prs = find_own_property(&pr, p, prop);
+    if (prs)
+        return JS_SetGlobalVar(ctx, prop, val, 0);
+    ret = JS_HasProperty(ctx, ctx->global_obj, prop);
+    if (ret <= 0) {
+        JS_FreeValue(ctx, val);
+        if (ret == 0)
+            JS_ThrowReferenceErrorNotDefined(ctx, prop);
+        return -1;
+    }
+    return JS_SetPropertyInternal(ctx, ctx->global_obj, prop, val, JS_PROP_THROW);
+}
