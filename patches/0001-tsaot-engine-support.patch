+    JSGCChunk *ch = h->run_chunk[cls];
+    if (ch && r->ptr < r->end) {
+        uint32_t i = js_gc_index(ch, (uintptr_t)r->ptr);
+        uint32_t j = js_gc_index(ch, (uintptr_t)r->end);
+        if (ch->n_allocated == ch->n_cells)
+            list_add_tail(&ch->avail_link, &h->avail[cls]);
+        js_gc_clear_bits(ch->bits, i, j);
+        ch->n_allocated -= j - i;
