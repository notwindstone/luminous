+    rt->mf.js_free(rt->malloc_state.opaque, h->table_chunks);
+    rt->mf.js_free(rt->malloc_state.opaque, h->stack);
+    rt->mf.js_free(rt->malloc_state.opaque, h->others);
+    rt->mf.js_free(rt->malloc_state.opaque, h->remembered);
