+bool JS_LayoutCheck(void)
+{
+    union { JSObject p; uint32_t w[JS_LAYOUT_OBJ_SIZE / 4]; } o, a;
+    union { JSMallocBlockHeader b; uint8_t c[sizeof(JSMallocBlockHeader)]; } h;
+    memset(&o, 0, sizeof(o));
+    o.p.extensible = true;
+    o.p.class_id = JS_CLASS_OBJECT;
+    memset(&a, 0, sizeof(a));
+    a.p.extensible = true;
+    a.p.fast_array = true;
+    a.p.class_id = JS_CLASS_ARRAY;
+    union { JSMallocBlockHeader b; uint8_t c[sizeof(JSMallocBlockHeader)]; } m, r;
+    memset(&h, 0xff, sizeof(h));
+    h.b.gc_obj_type = JS_GC_OBJ_TYPE_JS_OBJECT;
+    h.b.gc_remembered = 0;
+    h.b.mark = 0;
+    memset(&m, 0, sizeof(m));
+    m.b.mark = 1;
+    memset(&r, 0, sizeof(r));
+    r.b.gc_remembered = 1;
+    return m.c[sizeof(JSMallocBlockHeader) + JS_LAYOUT_GC_FLAGS] == 0x80 &&
+        r.c[sizeof(JSMallocBlockHeader) + JS_LAYOUT_GC_FLAGS] == 0x40 &&
+        o.w[JS_LAYOUT_OBJ_FLAGS / 4] == JS_LAYOUT_OBJ_PLAIN_FLAGS &&
+        a.w[JS_LAYOUT_OBJ_FLAGS / 4] == JS_LAYOUT_OBJ_APPEND_FLAGS &&
+        (JS_LAYOUT_OBJ_APPEND_FLAGS & ~JS_LAYOUT_OBJ_APPEND_MASK) == 0 &&
+        h.c[offsetof(JSMallocBlockHeader, ref_count) - 1] == 0;
