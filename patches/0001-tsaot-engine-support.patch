+/* ---- tsaot: the GC heap ----
+   GC cells (objects, strings and ropes, bigints, shapes, function
+   bytecode, var refs, async function data) come from chunks of their own:
+   JS_GC_CHUNK_SIZE bytes aligned to that size (a cell bigger than
+   JS_GC_MAX_CELL gets a chunk of its own, larger), each of one cell size,
+   with a bit per cell telling the allocated ones. Any address in a cell
+   finds the cell (js_gc_find), and the free cells are known without reading
+   them. A cell keeps the JSMallocBlockHeader before its user data
+   (block_size_idx JS_GC_CELL). Free cells are handed out in runs of
+   consecutive ones, zeroed: the allocation fast path bumps a pointer. */
+
+static const uint16_t gc_big_sizes[JS_GC_BIG_CLASS_COUNT] = {
+    640, 768, 896, 1024, 1280, 1536, 1792, 2048, 2560, 3072,
+    3584, 4096, 5120, 6144, 7168, 8192, 10240, 12288, 14336, 16384,
+};
+
+static inline uint32_t js_gc_cell_size(int cls)
+{
+    return cls < JS_ARENA_BLOCK_SIZE_COUNT ? arena_block_sizes[cls] :
+        gc_big_sizes[cls - JS_ARENA_BLOCK_SIZE_COUNT];
+}
+
+/* The class of cells of `total` bytes (with the header, a multiple of 8),
+   or -1 if larger than any. */
+static inline int js_gc_class(JSRuntime *rt, size_t total)
+{
+    int i;
+    if (total <= JS_ARENA_MAX_SMALL_SIZE)
+        return rt->arena_state.size_index[total / 8];
+    for (i = 0; i < JS_GC_BIG_CLASS_COUNT; i++) {
+        if (total <= gc_big_sizes[i])
+            return JS_ARENA_BLOCK_SIZE_COUNT + i;
+    }
+    return -1;
+}
+
+static inline uint32_t js_gc_index(const JSGCChunk *ch, uintptr_t cell)
+{
+    return (uint32_t)(((cell - (uintptr_t)ch - ch->first) * ch->inv) >> 40);
+}
+
+static inline uint8_t *js_gc_cell_at(JSGCChunk *ch, uint32_t i)
+{
+    return (uint8_t *)ch + ch->first + (size_t)i * ch->cell_size;
+}
+
+static inline uint32_t js_gc_hash(uintptr_t key, int bits)
+{
+    return (uint32_t)(((uint64_t)(key >> JS_GC_CHUNK_SHIFT) * 0x9E3779B97F4A7C15ull) >> (64 - bits));
+}
+
+static JSGCChunk *js_gc_table_get(const JSGCHeap *h, uintptr_t key)
+{
+    uint32_t mask, i;
+    if (!h->table_keys)
+        return NULL;
+    mask = (1u << h->table_bits) - 1;
+    for (i = js_gc_hash(key, h->table_bits);; i = (i + 1) & mask) {
+        uintptr_t k = h->table_keys[i];
+        if (k == key)
+            return h->table_chunks[i];
+        if (k == 0)
+            return NULL;
+    }
+}
+
+static void js_gc_table_insert(JSGCHeap *h, uintptr_t key, JSGCChunk *ch)
+{
+    uint32_t mask = (1u << h->table_bits) - 1, i;
+    for (i = js_gc_hash(key, h->table_bits); h->table_keys[i] != 0; i = (i + 1) & mask)
+        continue;
+    h->table_keys[i] = key;
+    h->table_chunks[i] = ch;
+    h->table_count++;
+}
+
+static int js_gc_table_put(JSRuntime *rt, uintptr_t key, JSGCChunk *ch)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    if (!h->table_keys || 2 * (h->table_count + 1) > (1u << h->table_bits)) {
+        uint32_t old_n = h->table_keys ? 1u << h->table_bits : 0, i;
+        uintptr_t *old_keys = h->table_keys;
+        JSGCChunk **old_chunks = h->table_chunks;
+        int bits = h->table_keys ? h->table_bits + 1 : 8;
+        uintptr_t *keys = rt->mf.js_calloc(rt->malloc_state.opaque, (size_t)1 << bits, sizeof(*keys));
+        JSGCChunk **chunks = rt->mf.js_calloc(rt->malloc_state.opaque, (size_t)1 << bits, sizeof(*chunks));
+        if (!keys || !chunks) {
+            rt->mf.js_free(rt->malloc_state.opaque, keys);
+            rt->mf.js_free(rt->malloc_state.opaque, chunks);
+            return -1;
+        }
+        h->table_keys = keys;
+        h->table_chunks = chunks;
+        h->table_bits = bits;
+        h->table_count = 0;
+        for (i = 0; i < old_n; i++) {
+            if (old_keys[i])
+                js_gc_table_insert(h, old_keys[i], old_chunks[i]);
+        }
+        rt->mf.js_free(rt->malloc_state.opaque, old_keys);
+        rt->mf.js_free(rt->malloc_state.opaque, old_chunks);
+    }
+    js_gc_table_insert(h, key, ch);
+    return 0;
+}
+
+static void js_gc_table_del(JSGCHeap *h, uintptr_t key)
+{
+    uint32_t mask = (1u << h->table_bits) - 1, i, j, k;
+    for (i = js_gc_hash(key, h->table_bits); h->table_keys[i] != key; i = (i + 1) & mask)
+        assert(h->table_keys[i] != 0);
+    /* (Linear probing: the entries after it move up where they can.) */
+    for (j = i;;) {
+        h->table_keys[i] = 0;
+        for (;;) {
+            j = (j + 1) & mask;
+            if (h->table_keys[j] == 0) {
+                h->table_count--;
+                return;
+            }
+            k = js_gc_hash(h->table_keys[j], h->table_bits);
+            if (i <= j ? (k <= i || k > j) : (k <= i && k > j))
+                break;
+        }
+        h->table_keys[i] = h->table_keys[j];
+        h->table_chunks[i] = h->table_chunks[j];
+        i = j;
+    }
+}
