+        size = (hdr + cell_size + 4095) & ~(size_t)4095;
+    } else {
+        size = JS_GC_CHUNK_SIZE;
+        n = (size - sizeof(JSGCChunk)) / cell_size;
+        for (;;) {
+            words = (n + 63) / 64;
+            hdr = (sizeof(JSGCChunk) + JS_GC_BITMAPS * 8 * words + 15) & ~(size_t)15;
+            if (hdr + (size_t)n * cell_size <= size)
+                break;
+            n--;
