+    if (max == 0 || h->stress)
+        max = 1;
+    if (max > room)
+        max = room;
+    e = js_gc_scan_bits(ch->bits, f, ch->n_cells, true);
+    if (e - f > max)
+        e = f + max;
+    js_gc_set_bits(ch->bits, f, e);
+    ch->n_allocated += e - f;
+    s->malloc_count += e - f;
+    s->malloc_size += (size_t)(e - f) * used;
+    ch->touched = 1;
+    if (ch->n_allocated == ch->n_cells)
