+/* Generic operators with exactly the interpreter's semantics, for code
+   generated outside of the bytecode interpreter. Operands are borrowed; the
+   result is returned, or JS_EXCEPTION. */
+JSValue JS_BinaryOperator(JSContext *ctx, JSBinaryOperatorEnum op,
+                          JSValueConst op1, JSValueConst op2)
+{
+    JSValue buf[2], *sp = buf + 2;
+    int ret;
+
+    buf[0] = js_dup(op1);
+    buf[1] = js_dup(op2);
+    switch (op) {
+    case JS_BINOP_ADD: ret = js_add_slow(ctx, sp); break;
+    case JS_BINOP_SUB: ret = js_binary_arith_slow(ctx, sp, OP_sub); break;
+    case JS_BINOP_MUL: ret = js_binary_arith_slow(ctx, sp, OP_mul); break;
+    case JS_BINOP_DIV: ret = js_binary_arith_slow(ctx, sp, OP_div); break;
+    case JS_BINOP_MOD: ret = js_binary_arith_slow(ctx, sp, OP_mod); break;
+    case JS_BINOP_POW: ret = js_binary_arith_slow(ctx, sp, OP_pow); break;
+    case JS_BINOP_SHL: ret = js_binary_logic_slow(ctx, sp, OP_shl); break;
+    case JS_BINOP_SAR: ret = js_binary_logic_slow(ctx, sp, OP_sar); break;
+    case JS_BINOP_SHR: ret = js_shr_slow(ctx, sp); break;
+    case JS_BINOP_AND: ret = js_binary_logic_slow(ctx, sp, OP_and); break;
+    case JS_BINOP_OR:  ret = js_binary_logic_slow(ctx, sp, OP_or); break;
+    case JS_BINOP_XOR: ret = js_binary_logic_slow(ctx, sp, OP_xor); break;
+    case JS_BINOP_LT:  ret = js_relational_slow(ctx, sp, OP_lt); break;
+    case JS_BINOP_LTE: ret = js_relational_slow(ctx, sp, OP_lte); break;
+    case JS_BINOP_GT:  ret = js_relational_slow(ctx, sp, OP_gt); break;
+    case JS_BINOP_GTE: ret = js_relational_slow(ctx, sp, OP_gte); break;
+    case JS_BINOP_EQ:  ret = js_eq_slow(ctx, sp, false); break;
+    case JS_BINOP_NEQ: ret = js_eq_slow(ctx, sp, true); break;
+    case JS_BINOP_STRICT_EQ:  ret = js_strict_eq_slow(ctx, sp, false); break;
+    case JS_BINOP_STRICT_NEQ: ret = js_strict_eq_slow(ctx, sp, true); break;
+    case JS_BINOP_IN:
+    case JS_BINOP_INSTANCEOF:
+        /* these leave their operands in place on failure */
+        ret = op == JS_BINOP_IN ? js_operator_in(ctx, sp)
+                                : js_operator_instanceof(ctx, sp);
+        if (ret < 0) {
+            JS_FreeValue(ctx, buf[0]);
+            JS_FreeValue(ctx, buf[1]);
+        }
+        break;
+    default:
+        JS_FreeValue(ctx, buf[0]);
+        JS_FreeValue(ctx, buf[1]);
+        return JS_ThrowInternalError(ctx, "invalid binary operator");
+    }
+    if (ret < 0)
+        return JS_EXCEPTION;
+    return buf[0];
+}
+
+JSValue JS_UnaryOperator(JSContext *ctx, JSUnaryOperatorEnum op,
+                         JSValueConst op1)
+{
+    JSValue buf[1], *sp = buf + 1;
+    int ret;
+
+    switch (op) {
+    case JS_UNOP_TYPEOF:
+        return JS_AtomToString(ctx, js_operator_typeof(ctx, op1));
+    case JS_UNOP_TONUMERIC:
+        return JS_ToNumericFree(ctx, js_dup(op1));
+    default:
+        break;
+    }
+    buf[0] = js_dup(op1);
+    switch (op) {
+    case JS_UNOP_NEG:    ret = js_unary_arith_slow(ctx, sp, OP_neg); break;
+    case JS_UNOP_PLUS:   ret = js_unary_arith_slow(ctx, sp, OP_plus); break;
+    case JS_UNOP_INC:    ret = js_unary_arith_slow(ctx, sp, OP_inc); break;
+    case JS_UNOP_DEC:    ret = js_unary_arith_slow(ctx, sp, OP_dec); break;
+    case JS_UNOP_BITNOT: ret = js_not_slow(ctx, sp); break;
+    default:
+        JS_FreeValue(ctx, buf[0]);
+        return JS_ThrowInternalError(ctx, "invalid unary operator");
+    }
+    if (ret < 0)
+        return JS_EXCEPTION;
+    return buf[0];
+}
