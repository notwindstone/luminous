+        h->spare_count--;
+        memset(ch->bits, 0, JS_GC_BITMAPS * 8 * words);
+        ch->cell_size = cell_size;
+        ch->n_cells = n;
+        ch->first = hdr;
+        ch->n_words = words;
+        ch->n_allocated = 0;
+        ch->cls = cls;
+        ch->dirty = 1;
+        ch->touched = 0;
+        ch->inv = (((uint64_t)1 << 40) + cell_size - 1) / cell_size;
+        list_add_tail(&ch->link, &h->chunks[cls]);
+        list_add_tail(&ch->avail_link, &h->avail[cls]);
+        return ch;
+    }
+    ch = cls == JS_GC_LARGE ? js_gc_map(size) : js_gc_map_chunk(h);
+    if (!ch)
+        return NULL;
+    if (++h->n_chunks > h->peak_chunks)
+        h->peak_chunks = h->n_chunks;
+    ch->size = size;
+    ch->cell_size = cell_size;
+    ch->n_cells = n;
+    ch->first = hdr;
+    ch->n_words = words;
+    ch->n_allocated = 0;
+    ch->cls = cls;
+    ch->dirty = 0;
+    ch->touched = 0;
+    ch->populated = 0;
+    ch->inv = (((uint64_t)1 << 40) + cell_size - 1) / cell_size;
+    for (off = 0; off < size; off += JS_GC_CHUNK_SIZE) {
+        if (js_gc_table_put(rt, (uintptr_t)ch + off, ch) < 0) {
+            while (off > 0) {
