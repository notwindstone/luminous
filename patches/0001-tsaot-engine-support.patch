+    memset(p, 0, sizeof(JSObject));
+    p->class_id = class_id;
+    p->extensible = extensible;
+    p->is_exotic = ctx->rt->class_array[class_id].exotic != NULL;
+    p->shape = sh;
+    p->prop = NULL;
+    p->u.opaque = p + 1;
+    *pdata = p + 1;
+    JS_REF_COUNT(p) = 1;
