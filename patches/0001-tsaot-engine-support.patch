+    if (!p) {
+        js_free_shape(ctx->rt, sh);
+        return JS_EXCEPTION;
+    }
+    /* The data is the caller's to initialize. */
+    memset(p, 0, sizeof(JSObject));
+    p->class_id = class_id;
+    p->extensible = extensible;
+    p->is_exotic = ctx->rt->class_array[class_id].exotic != NULL;
+    p->shape = sh;
+    p->prop = NULL;
+    p->u.opaque = p + 1;
+    *pdata = p + 1;
+    JS_REF_COUNT(p) = 1;
+    add_gc_object(ctx->rt, &p->header, JS_GC_OBJ_TYPE_JS_OBJECT);
+    if (ctx->rt->class_array[class_id].finalizer)
+        js_gc_set_fin(p);
