+/* An empty chunk: kept for any class (its cells not found by js_gc_find:
+   no class, no cells) while few are, else unmapped. */
+static void js_gc_release_chunk(JSRuntime *rt, JSGCChunk *ch, uint32_t keep)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    if (ch->cls == JS_GC_LARGE || h->spare_count >= keep) {
+        js_gc_free_chunk(rt, ch);
