+/* `await value` for code generated outside of the interpreter: as the
+   interpreter's await, PromiseResolve(%Promise%, value) then
+   PerformPromiseThen(promise, on_fulfilled, on_rejected) with no result
+   capability (no observable `then` lookups). Returns -1 on exception. */
+int JS_AwaitValue(JSContext *ctx, JSValueConst value, JSValueConst on_fulfilled,
+                  JSValueConst on_rejected)
+{
+    JSValueConst funcs[2] = { on_fulfilled, on_rejected };
+    JSValueConst none[2] = { JS_UNDEFINED, JS_UNDEFINED };
+    JSValue promise;
+    int res;
+
+    promise = js_promise_resolve(ctx, ctx->promise_ctor, 1, &value, 0);
+    if (JS_IsException(promise))
+        return -1;
+    res = perform_promise_then(ctx, promise, funcs, none);
+    JS_FreeValue(ctx, promise);
+    return res;
+}
