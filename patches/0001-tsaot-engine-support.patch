+static void js_gc_init(JSRuntime *rt)
+{
+    JSGCHeap *h = &rt->gc_heap;
+    int i;
+    memset(h, 0, sizeof(*h));
+    for (i = 0; i < JS_GC_CLASS_COUNT; i++) {
+        init_list_head(&h->chunks[i]);
+        init_list_head(&h->avail[i]);
+    }
+    init_list_head(&h->large);
+    init_list_head(&h->spare);
+    init_list_head(&h->dead_contexts);
