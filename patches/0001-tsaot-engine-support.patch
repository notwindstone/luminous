+    }
+    list_del(&ch->link);
+    if (ch->n_allocated < ch->n_cells)
+        list_del(&ch->avail_link);
+    ch->n_cells = 0;
+    ch->n_allocated = 0;
+    list_add_tail(&ch->link, &h->spare);
+    h->spare_count++;
