+int JS_CacheOwnProperty(JSContext *ctx, JSValueConst obj, JSAtom prop,
+                        bool for_write, void **pshape)
+{
+    JSObject *p;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    int flags;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return -1;
+    p = JS_VALUE_GET_OBJ(obj);
+    /* Only shared shapes: an unhashed shape belongs to one object, which
+       may modify it in place. A hashed one, once referenced here, is cloned
+       by any modification (js_shape_prepare_update, add_property). */
+    if (!p->shape->is_hashed)
+        return -1;
+    prs = find_own_property(&pr, p, prop);
+    if (!prs)
+        return -1;
+    flags = prs->flags;
+    if ((flags & JS_PROP_TMASK) != JS_PROP_NORMAL || (flags & JS_PROP_LENGTH))
+        return -1;
+    if (for_write && !(flags & JS_PROP_WRITABLE))
+        return -1;
+    *pshape = js_dup_shape(p->shape);
+    return pr - p->prop;
+}
+
+void JS_FreeCachedShape(JSRuntime *rt, void *shape)
+{
+    js_free_shape(rt, shape);
+}
+
+void JS_MarkCachedShape(JSRuntime *rt, void *shape, JS_MarkFunc *mark_func)
+{
+    mark_func(rt, &((JSShape *)shape)->header);
+}
