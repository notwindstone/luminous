+/* Whether `atom` is an array index (only a string starting with a digit
+   can be one, if it is not already an integer atom). */
+static bool js_for_in_index_atom(JSContext *ctx, JSAtom atom, uint32_t *pidx)
+{
+    JSString *p;
+    int c;
+    if (__JS_AtomIsTaggedInt(atom))
+        return true;
+    p = ctx->rt->atom_array[atom];
+    if (p->len == 0)
+        return false;
+    c = string_get(p, 0);
+    return c >= '0' && c <= '9' && JS_AtomIsArrayIndex(ctx, pidx, atom);
+}
+
+/* Whether `obj` can be enumerated by walking its shape: an ordinary object
+   with a shared shape, no enumerable array index keys (which would come
+   first) and no enumerable keys on its prototype chain. */
+static bool js_for_in_by_shape(JSContext *ctx, JSObject *p)
+{
+    JSShape *sh = p->shape;
+    JSShapeProperty *prs;
+    uint32_t i, idx;
+
+    if (p->is_exotic || p->fast_array || !sh->is_hashed)
+        return false;
+    for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+        if (prs->atom != JS_ATOM_NULL && (prs->flags & JS_PROP_ENUMERABLE) &&
+            js_for_in_index_atom(ctx, prs->atom, &idx))
+            return false;
+    }
+    for (p = sh->proto; p; p = p->shape->proto) {
+        if (p->is_exotic && !(p->class_id == JS_CLASS_ARRAY && p->fast_array && p->u.array.count == 0))
+            return false;
+        sh = p->shape;
+        for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+            if (prs->atom != JS_ATOM_NULL && (prs->flags & JS_PROP_ENUMERABLE) &&
+                (__JS_AtomIsTaggedInt(prs->atom) ||
+                 ctx->rt->atom_array[prs->atom]->atom_type == JS_ATOM_TYPE_STRING))
+                return false;
+        }
+    }
+    return true;
+}
+
+JSValue JS_ForInIteratorObject(JSContext *ctx, JSValueConst obj)
+{
+    JSValue enum_obj;
+    JSForInIterator *it;
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT || !js_for_in_by_shape(ctx, JS_VALUE_GET_OBJ(obj)))
+        return build_for_in_iterator(ctx, js_dup(obj));
+    p = JS_VALUE_GET_OBJ(obj);
+    it = js_malloc(ctx, sizeof(*it));
+    if (!it)
+        return JS_EXCEPTION;
+    enum_obj = JS_NewObjectProtoClass(ctx, JS_NULL, JS_CLASS_FOR_IN_ITERATOR);
+    if (JS_IsException(enum_obj)) {
+        js_free(ctx, it);
+        return JS_EXCEPTION;
+    }
+    it->is_array = false;
+    it->obj = js_dup(obj);
+    it->idx = 0;
+    it->slot = 0;
+    it->shape = js_dup_shape(p->shape);
+    JS_VALUE_GET_OBJ(enum_obj)->u.for_in_iterator = it;
+    return enum_obj;
+}
+
+JSValue JS_ForInGet(JSContext *ctx, JSValueConst enum_obj, JSValueConst obj, JSValueConst key)
+{
+    JSForInIterator *it;
+    JSShapeProperty *prs;
+    JSObject *p;
+
+    /* `obj[key]` where key is the last key of a shape iteration and obj has
+       that shape: the property is in that slot */
+    if (JS_VALUE_GET_TAG(enum_obj) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_OBJ(enum_obj)->class_id == JS_CLASS_FOR_IN_ITERATOR &&
+        JS_VALUE_GET_TAG(obj) == JS_TAG_OBJECT && JS_VALUE_GET_TAG(key) == JS_TAG_STRING) {
+        it = JS_VALUE_GET_OBJ(enum_obj)->u.for_in_iterator;
+        p = JS_VALUE_GET_OBJ(obj);
+        if (it->shape && p->shape == it->shape && it->slot < it->shape->prop_count) {
+            prs = &get_shape_prop(it->shape)[it->slot];
+            if ((prs->flags & JS_PROP_TMASK) == JS_PROP_NORMAL &&
+                JS_VALUE_GET_PTR(key) == ctx->rt->atom_array[prs->atom])
+                return js_dup(p->prop[it->slot].u.value);
+        }
+    }
+    return JS_GetPropertyValue(ctx, obj, js_dup(key));
+}
+
+JSValue JS_ForInStep(JSContext *ctx, JSValueConst enum_obj, int *pdone)
+{
+    JSValue sp[3];
+    sp[0] = unsafe_unconst(enum_obj);
+    if (js_for_in_next(ctx, sp + 1))
+        return JS_EXCEPTION;
+    *pdone = JS_VALUE_GET_BOOL(sp[2]);
+    return sp[1];
+}
