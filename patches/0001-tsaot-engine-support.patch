+    struct list_head *el, *el1;
+    int i;
+    for (i = 0; i < JS_GC_CLASS_COUNT; i++) {
+        list_for_each_safe(el, el1, &h->chunks[i])
+            js_gc_unmap(list_entry(el, JSGCChunk, link), list_entry(el, JSGCChunk, link)->size);
+    }
+    list_for_each_safe(el, el1, &h->large)
+        js_gc_unmap(list_entry(el, JSGCChunk, link), list_entry(el, JSGCChunk, link)->size);
+    list_for_each_safe(el, el1, &h->spare)
+        js_gc_unmap(list_entry(el, JSGCChunk, link), list_entry(el, JSGCChunk, link)->size);
