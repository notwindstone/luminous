+    case 0:
+        r = ((JSNativeCmpAny *)s->cmp)(ctx, NULL, js_dup(a), js_dup(b));
+        break;
+    case 1:
+        r = ((JSNativeCmpNum *)s->cmp)(ctx, NULL, js_native_number(a), js_native_number(b));
+        break;
+    case 2:
+        v = ((JSNativeCmpAnyV *)s->cmp)(ctx, NULL, js_dup(a), js_dup(b));
+        break;
+    default:
+        v = ((JSNativeCmpNumV *)s->cmp)(ctx, NULL, js_native_number(a), js_native_number(b));
+        break;
+    }
