+    if (unlikely(h->stress) || unlikely(s->malloc_size > rt->malloc_gc_threshold))
+        js_trigger_gc(rt, 0);
+    js_gc_end_run(rt, cls);
+    /* (as js_malloc compares: a limit of 0 is none) */
+    if (unlikely(s->malloc_size + used > s->malloc_limit - 1))
+        return -1;
+    room = (s->malloc_limit - 1 - s->malloc_size) / used;
+    ch = h->run_chunk[cls];
+    f = h->run_next[cls];
+    for (;;) {
+        if (ch && ch->n_allocated < ch->n_cells) {
+            f = js_gc_scan_bits(ch->bits, f, ch->n_cells, false);
+            if (f < ch->n_cells)
+                break;
+        }
+        if (!list_empty(&h->avail[cls])) {
+            ch = list_entry(h->avail[cls].next, JSGCChunk, avail_link);
+            /* (Looked at in turn: to the end of the list.) */
+            list_del(&ch->avail_link);
+            list_add_tail(&ch->avail_link, &h->avail[cls]);
+            f = js_gc_scan_bits(ch->bits, 0, ch->n_cells, false);
+            if (f < ch->n_cells)
+                break;
+            /* (Full: off the list.) */
+            list_del(&ch->avail_link);
+            ch = NULL;
+            continue;
+        }
+        ch = js_gc_new_chunk(rt, cls, cell_size);
+        if (!ch)
