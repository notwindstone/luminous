+}
+
+int JS_PrivateCheckBrand(JSContext *ctx, JSValueConst obj, JSValueConst method)
+{
+    int ret = JS_CheckBrand(ctx, unsafe_unconst(obj), unsafe_unconst(method));
+    if (ret == 0) {
+        JS_ThrowTypeError(ctx, "invalid brand on object");
+        return -1;
+    }
+    return ret;
+}
+
+int JS_PrivateIn(JSContext *ctx, JSValueConst obj, JSValueConst name)
+{
+    JSValue sp[2];
+    int ret;
+    sp[0] = js_dup(obj);
+    sp[1] = js_dup(name);
+    if (js_operator_private_in(ctx, sp + 2)) {
+        JS_FreeValue(ctx, sp[0]);
+        JS_FreeValue(ctx, sp[1]);
+        return -1;
+    }
+    ret = JS_VALUE_GET_BOOL(sp[0]);
+    return ret;
+}
