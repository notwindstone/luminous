+/* luminous: whether key `prop` is an atom's own string or a symbol (not a
+   private name), and in *patom its atom (not referenced). */
+static inline bool js_key_atom(JSRuntime *rt, JSValueConst prop, JSAtom *patom)
+{
+    JSAtomStruct *p;
+    if (JS_VALUE_GET_TAG(prop) == JS_TAG_STRING) {
+        p = JS_VALUE_GET_STRING(prop);
+        if (p->atom_type != JS_ATOM_TYPE_STRING)
+            return false;
+        *patom = p->atom_index;
+        return true;
+    }
+    if (JS_VALUE_GET_TAG(prop) == JS_TAG_SYMBOL) {
+        p = JS_VALUE_GET_PTR(prop);
+        if (p->atom_type != JS_ATOM_TYPE_SYMBOL && p->atom_type != JS_ATOM_TYPE_GLOBAL_SYMBOL)
+            return false;
+        *patom = js_get_atom_index(rt, p);
+        return true;
+    }
+    return false;
+}
