+        { JS_ATOM_Symbol_match, (void *)js_regexp_Symbol_match },
+        { JS_ATOM_Symbol_matchAll, (void *)js_regexp_Symbol_matchAll },
+        { JS_ATOM_Symbol_replace, (void *)js_regexp_Symbol_replace },
+        { JS_ATOM_Symbol_search, (void *)js_regexp_Symbol_search },
+        { JS_ATOM_Symbol_split, (void *)js_regexp_Symbol_split },
+    };
+    /* (names that are no predefined atoms: those would renumber the atoms
+       of the builtins compiled to bytecode) */
+    static const struct { const char *name; int flag; } flags[] = {
+        { "hasIndices", LRE_FLAG_INDICES }, { "global", LRE_FLAG_GLOBAL },
+        { "ignoreCase", LRE_FLAG_IGNORECASE }, { "multiline", LRE_FLAG_MULTILINE },
+        { "dotAll", LRE_FLAG_DOTALL }, { "unicode", LRE_FLAG_UNICODE },
+        { "unicodeSets", LRE_FLAG_UNICODE_SETS }, { "sticky", LRE_FLAG_STICKY },
+    };
