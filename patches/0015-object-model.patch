+    if (len == 0 || len > JS_ARRAY_INLINE_MAX) {
+        obj = JS_NewObjectFromShape(ctx, sh, JS_CLASS_ARRAY, props);
+        if (!JS_IsException(obj) && len > 0 && expand_fast_array(ctx, JS_VALUE_GET_OBJ(obj), len)) {
