+/* luminous: compiled code caches a prototype's method or getter with the
+   value of this counter, and uses it while the counter is unchanged:
+   every change to an object it watches (JS_WatchPrototype) moves it. */
+uint64_t js_proto_epoch = 1;
+
+/* Watch `obj` (an object): from now on, a change to its properties, their
+   values or its prototype moves js_proto_epoch. It gets a shape of its
+   own the first time (still shared, so that it can be cached), so that no
+   cache of the shape it had writes to it directly any more; and no cache
+   takes it for writes (JS_CacheOwnProperty). Returns -1 if it cannot be
+   watched. */
+int JS_WatchPrototype(JSContext *ctx, JSValueConst obj)
+{
+    JSObject *p;
+    JSShape *sh;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return -1;
+    p = JS_VALUE_GET_OBJ(obj);
+    if (p->is_watched)
+        return 0;
+    sh = p->shape;
+    if (sh->is_hashed) {
+        sh = js_clone_shape(ctx, sh);
+        if (!sh)
+            return -1;
+        js_free_shape(ctx->rt, p->shape);
+        p->shape = sh;
+        js_gc_wb(ctx->rt, p);
+        p->is_watched = true;
+        if (JS_ShareObjectShape(ctx, obj) < 0)
+            return -1;
+        return 0;
+    }
+    p->is_watched = true;
+    return 0;
+}
+
 static bool js_cacheable_holder(JSObject *p)
 {
     return (!p->is_exotic || p->class_id == JS_CLASS_ARRAY) && p->shape->is_hashed;
 }
 
+/* Watch the prototypes of `obj` from the first up to the one that has
+   `prop`, `depth` of them at most (JS_WatchPrototype): before caching what
+   they hold, as the first watch gives an object another shape. */
+void JS_WatchProtoChain(JSContext *ctx, JSValueConst obj, JSAtom prop, int depth)
+{
+    JSObject *p, *proto;
+    JSProperty *pr;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return;
+    p = JS_VALUE_GET_OBJ(obj);
+    while (depth-- > 0) {
+        proto = p->shape->proto;
+        if (!proto || (proto->is_exotic && proto->class_id != JS_CLASS_ARRAY))
+            return;
+        if (JS_WatchPrototype(ctx, JS_MKPTR(JS_TAG_OBJECT, proto)) < 0)
+            return;
+        if (find_own_property(&pr, proto, prop))
+            return;
+        p = proto;
+    }
+}
