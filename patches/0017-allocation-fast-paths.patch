+/* luminous: a new plain object (JS_CLASS_OBJECT) of shape `sh` (a
+   reference taken), its properties zeroed (the caller sets them). All
+   inline, as js_new_object_data: JS_NewObjectFromShape's work for the
+   classes it does not handle is not done. */
+static inline __attribute__((always_inline)) JSValue js_new_plain_object(JSContext *ctx, JSShape *sh)
+{
+    JSRuntime *rt = ctx->rt;
+    size_t size = JS_PLAIN_OBJECT_SIZE + sizeof(JSProperty) * sh->prop_size;
+    JSObject *p;
+
+    js_trigger_gc(rt, size);
+    p = js_gc_alloc_rt(rt, size);
+    if (unlikely(!p)) {
+        js_free_shape(rt, sh);
+        JS_ThrowOutOfMemory(ctx);
+        return JS_EXCEPTION;
+    }
+    js_object_set_header(p, JS_CLASS_OBJECT, false);
+    p->shape = sh;
+    p->prop = (JSProperty *)&p->u;
+    if (sh->prop_count > 0)
+        memset(p->prop, 0, sizeof(JSProperty) * sh->prop_count);
+    JS_REF_COUNT(p) = 1;
+    add_gc_object(rt, &p->header, JS_GC_OBJ_TYPE_JS_OBJECT);
+    return JS_MKPTR(JS_TAG_OBJECT, p);
+}
+
+/* luminous: the most elements a new array has room for in its own cell */
+#define JS_ARRAY_INLINE_MAX 32
+
+/* luminous: a new array (of ctx->array_shape) with room for `len`
+   elements in its own cell (inline_values: see js_new_array_room; none
+   for 0), none yet. All inline, as js_new_plain_object. */
+static inline __attribute__((always_inline)) JSValue js_new_array_inline(JSContext *ctx, uint32_t len)
+{
+    JSRuntime *rt = ctx->rt;
+    JSShape *sh = ctx->array_shape;
+    size_t base = sizeof(JSObject) + sizeof(JSProperty) * sh->prop_size;
+    JSObject *p;
+
+    js_trigger_gc(rt, base + sizeof(JSValue) * len);
+    p = js_gc_alloc_rt(rt, base + sizeof(JSValue) * len);
+    if (unlikely(!p)) {
+        JS_ThrowOutOfMemory(ctx);
+        return JS_EXCEPTION;
+    }
+    js_object_set_header(p, JS_CLASS_ARRAY, true);
+    p->is_exotic = 1;
+    p->fast_array = 1;
+    p->inline_values = len > 0;
+    p->shape = js_dup_shape(sh);
+    p->prop = (JSProperty *)(p + 1);
+    p->prop[0].u.value = js_int32(0);
+    p->u.array.u.values = len > 0 ? (JSValue *)((uint8_t *)p + base) : NULL;
+    p->u.array.count = 0;
+    p->u.array.u1.size = len;
+    JS_REF_COUNT(p) = 1;
+    add_gc_object(rt, &p->header, JS_GC_OBJ_TYPE_JS_OBJECT);
+    return JS_MKPTR(JS_TAG_OBJECT, p);
+}
