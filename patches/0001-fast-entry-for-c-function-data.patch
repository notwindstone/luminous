+static inline bool js_is_c_function_data(JSValueConst v)
+{
+    return JS_VALUE_GET_TAG(v) == JS_TAG_OBJECT &&
+           JS_VALUE_GET_OBJ(v)->class_id == JS_CLASS_C_FUNCTION_DATA;
