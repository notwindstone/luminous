+/* luminous: the last position at or before `from` where p2 is in p1, or -1
+   (assuming 0 <= from <= p1->len - p2->len). */
+static int string_lastindexof(JSString *p1, JSString *p2, int from)
+{
+    int i, len2 = p2->len;
+    if (len2 == 0)
+        return from;
+    if (!p1->is_wide_char && !p2->is_wide_char) {
+        /* The first character, backward (memrchr), then the rest. */
+        const uint8_t *s = str8(p1), *t = str8(p2);
+        for (i = from; i >= 0; i--) {
+#if defined(__GLIBC__)
+            const uint8_t *q = memrchr(s, t[0], i + 1);
+            if (!q)
+                break;
+            i = q - s;
+#else
+            if (s[i] != t[0])
+                continue;
+#endif
+            if (len2 == 1 || bytes_eq(s + i + 1, t + 1, len2 - 1))
+                return i;
+        }
+        return -1;
+    }
+    for (i = from; i >= 0; i--) {
+        if (string_eq_at(p1, p2, i, 0, len2))
+            return i;
+    }
+    return -1;
+}
