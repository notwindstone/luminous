+/* luminous: parts[0] + parts[1] + ... + parts[n - 1] (all taken), as `+`
+   adds them, left to right: concatenated at once when the first or second
+   is a string and none is an object (whose ToPrimitive could differ from
+   ToString), else pair by pair. */
+JSValue JS_AddValuesN(JSContext *ctx, JSValue *parts, int n)
+{
+    JSValue r, s;
+    int i, str = 0, obj = 0;
+
+    for (i = 0; i < n; i++) {
+        int t = JS_VALUE_GET_TAG(parts[i]);
+        obj |= t == JS_TAG_OBJECT;
+        str |= i < 2 && tag_is_string(t);
+    }
+    if (str && !obj)
+        return JS_ConcatStrings(ctx, parts, n);
+    r = parts[0];
+    for (i = 1; i < n; i++) {
+        s = JS_AddValues(ctx, r, parts[i]);
+        JS_FreeValue(ctx, r);
+        JS_FreeValue(ctx, parts[i]);
+        r = s;
+        if (JS_IsException(r)) {
+            for (i++; i < n; i++)
+                JS_FreeValue(ctx, parts[i]);
+            break;
+        }
+    }
+    return r;
+}
